PUBLIC_ORIGIN=https://conferevoto.com.br
PORT=3000
# No Docker, HOST=0.0.0.0 já está definido na imagem.
# Fora do Docker, o padrão continua sendo 127.0.0.1.
GOOGLE_ANALYTICS_ID=

# Configure com um provedor SMTP. O destinatário fica apenas no servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Endereço remetente autorizado pelo provedor (não é o e-mail do visitante).
CONTACT_FROM=
